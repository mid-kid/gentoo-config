# Build an application with clang

# include baseflags
CFLAGS="-O2 -pipe"
LDFLAGS="-Wl,-O1 -Wl,--as-needed -Wl,-z,pack-relative-relocs"

CC="$CHOST-clang"
CXX="$CHOST-clang++"
AR="llvm-ar"
NM="llvm-nm"
RANLIB="llvm-ranlib"
CFLAGS="$CFLAGS $__MARCH_FLAGS $__FLAGS_OPTIM_BASE -flto=thin $__FLAGS_OPTIM_GC"
CXXFLAGS="$CFLAGS"
LDFLAGS="$LDFLAGS $__FLAGS_LINK_GC -fuse-ld=lld"
